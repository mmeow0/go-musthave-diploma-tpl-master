# Конфигурация сервиса Гофермарт

# Адрес и порт запуска сервиса
RUN_ADDRESS=localhost:8080

# Адрес подключения к базе данных PostgreSQL
DATABASE_URI=postgres://postgres:postgres@localhost:5432/gophermart?sslmode=disable

# Адрес системы расчёта начислений
ACCRUAL_SYSTEM_ADDRESS=http://localhost:8081

# Уровень логирования (DEBUG, INFO, WARN, ERROR, FATAL)
LOG_LEVEL=INFO

# Секретный ключ для подписи токенов (будет сгенерирован автоматически, если не указан)
SECRET_KEY=
